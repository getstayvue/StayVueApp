{
  "appId": "com.stayvue.propertymanager",
  "appName": "StayVue",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "url": "https://your-deployed-url.com",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#5A7F4B",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#5A7F4B",
      "style": "LIGHT"
    }
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#5A7F4B"
  }
}
